   "id": "time",
   "name": "When comes early",
   "source": [
    "Time words and word order",
    "https://resources.allsetlearning.com/chinese/grammar/ASG5RWKO"
   ],
   "rule": "English often says when at the end: have dinner at seven. Chinese says when at the start, or straight after who: we seven o'clock eat dinner. Putting the time at the end does not sound natural in Chinese.",
   "examples": [
    {
     "zh": [
      [
       "我们",
       "who"
      ],
      [
       "七点",
       "when"
      ],
      [
       "吃晚饭。",
       "action"
      ]
     ],
     "en": [
      [
       "We",
       "who"
      ],
      [
       "have dinner",
       "action"
      ],
      [
       "at seven.",
       "when"
      ]
     ]
    },
    {
     "zh": [
      [
       "我",
       "who"
      ],
      [
       "今天",
       "when"
      ],
      [
       "要早点回家。",
       "action"
      ]
     ],
     "en": [
      [
       "I",
       "who"
      ],
      [
       "need to go home a little early",
       "action"
      ],
      [
       "today.",
       "when"
      ]
     ]
    },
    {
     "zh": [
      [
       "你",
       "who"
      ],
      [
       "今天下午",
       "when"
      ],
      [
       "会在家",
       "action"
      ],
      [
       "吗？",
       "question"
      ]
